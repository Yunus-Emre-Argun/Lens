<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Lens.Core\Lens.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [PILOT - DINOv2-Base] Aktif ONNX model: repo kokunde models/ altinda
         tutuluyor (buyuk binary, git'e commit edilmiyor - bkz.
         docs/DECISIONS.md #28). Build/publish ciktisinda "models\" alt
         klasorune kopyalanir, MainWindow.ResolveModelPath bunu
         AppContext.BaseDirectory altinda arar; dosya adinin tek kaynagi
         Lens.Core.Ai.DinoV2BaseProfile.ModelFileName'dir.

         CLIP modeli (clip-vision-b16-openai.onnx) bu dalda BILEREK
         PAKETLENMEZ: uygulama artik onu yuklemiyor ve iki buyuk modeli ayni
         pakete koymak gereksiz ~345 MB demektir. Dosyanin KENDISI repo'da
         (models/ altinda, gitignore'lu) DURUYOR - CLIP surumune donmek
         yalnizca bu satiri geri almayi gerektirir; eski CLIP index'i de
         (.lens/index.json) hic degistirilmedigi icin yeniden indeksleme
         gerekmez (bkz. docs/DECISIONS.md, LegacyClipIndexStore).

         [ClickOnce - 2026-09-08] item tipi bilerek "None" DEGIL "Content":
         Visual Studio'nun klasik ClickOnce manifest hedefleri
         (Microsoft.Common.CurrentVersion.targets, "_ClickOnceContentItems")
         yalnizca Content ogelerini application manifestine KOSULSUZ dahil
         eder - None ogeleri (uzantisi .exe/.dll olmayan) yalnizca ozel bir
         "PublishFile" eslesmesi varsa dahil olur. Normal SDK "dotnet publish"/
         CopyToOutputDirectory davranisi None ile Content arasinda farksizdir -
         bu degisiklik taşınabilir publish akisini (docs/DEPLOYMENT.md §1)
         ETKILEMEZ. Bilerek "IsDataFile" metadata'si YOK - model kullanici
         verisi degil, normal uygulama dosyasi olarak paketlenir (bkz.
         docs/CLICKONCE.md). -->
    <Content Include="..\..\models\dinov2-base.onnx"
             Link="models\dinov2-base.onnx"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\..\models\dinov2-base.onnx')" />

    <!-- [Faz 4A] Admin default config sablonu: repo'daki hali BOS gelir
         (gercek UNC path hardcode edilmez). IT, publish ciktisindaki
         appsettings.json'i exe ile ayni klasorde elle duzenler -
         bkz. docs/DECISIONS.md #41-42. [ClickOnce - 2026-09-08] "None"'dan
         "Content"'e tasindi - gerekce yukaridaki model yorumuyla ayni.
         SDK'nin varsayilan item glob'u appsettings.json'i zaten "None" olarak
         topladigindan, cakismayi (duplicate item) onlemek icin once "None
         Remove" ile o kaydi cikarilir. -->
    <None Remove="appsettings.json" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- [Ikon - 2026-09-08] Derlenen Lens.Desktop.exe'nin Win32 kaynak
         ikonunu (Gezgin/gorev cubugu/Alt-Tab) belirler - bkz.
         docs/DEVELOPMENT_SETUP.md veya ilgili ikon dokumani icin
         Assets/Lens.ico'nun nasil uretildigi. Ayni dosya, pencere basligi
         ikonu icin asagidaki "Resource" ogesiyle AYRICA (gereksiz kopya
         OLUSTURMADAN, tek fiziksel dosyadan) WPF pack-URI'ye de acilir. -->
    <ApplicationIcon>Assets\Lens.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- [Ikon - 2026-09-08] Pencere basligi ikonu (MainWindow.xaml vb.
         "Icon" ozelligi "/Assets/Lens.ico" pack-URI'siyle bu kaynagi
         okur) icin WPF derleme-zamani kaynagina dahil edilir. Ana tasarim
         kaynagi (lens-app-icon-master.png) BILEREK dahil edilmedi - yalnizca
         gelistirme zamani referans/kaynak dosyasidir, calisma zamaninda
         kullanilmaz. -->
    <Resource Include="Assets\Lens.ico" />
  </ItemGroup>

  <!-- [Sürüm bilgisi - 2026-09-07] SDK-style proje: bu üç deger, Visual Studio'da
       Solution Explorer -> Lens.Desktop projesine sag tik -> Properties -> Application
       sekmesi -> "Assembly Information..." (Assembly Version/File Version icin) VEYA
       dogrudan bu .csproj dosyasinin XML'i (Informational Version icin - bkz. asagidaki
       yorum) uzerinden degistirilir; XAML/C# icinde SABIT metin OLARAK YAZILMAZ (bkz.
       AppVersionInfo.GetDisplayVersion - TEK okuma kaynagi). AssemblyVersion/FileVersion
       SDK'nin GenerateAssemblyInfo hedefi tarafindan derleme sirasinda otomatik uretilir -
       AssemblyInfo.cs icine ELLE [assembly: AssemblyVersion(...)] EKLENMEDI (aksi halde
       duplicate attribute derleme HATASI olurdu); mevcut WPF ThemeInfo attribute'u
       (AssemblyInfo.cs) bu degisiklikten ETKILENMEDI. -->
  <PropertyGroup>
    <!-- Standart sayisal alanlar - yalnizca "major.minor.build.revision" bicimi
         gecerlidir (ör. "1.0.0.0"); VS Assembly Information dialogundaki "Assembly
         version"/"File version" alanlariyla BIREBIR eslesir. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <!-- Kullaniciya gosterilen serbest metin (tarih + kisa etiket) - Assembly
         Information dialogunda AYRI bir alan olarak GARANTI gorunmeyebilir (VS
         surumune gore degisir); en guvenilir/VS-surumunden-bagimsiz yol bu degeri
         doğrudan burada (.csproj dosyasi) duzenlemektir - bkz. docs/DEPLOYMENT.md
         "Surum Guncelleme (Yonetici Sureci)". -->
    <InformationalVersion>08.09.26 — v1.0</InformationalVersion>
    <!-- Bu proje su an bir SourceLink paketi kullanmadigindan pratikte etkisi yok,
         ama SDK'nin git commit hash'ini InformationalVersion sonuna "+<hash>" olarak
         OTOMATIK eklemesini (SourceRevisionId mevcutsa) kalici olarak ENGELLER - "08.09.26
         — v1.0" degeri HER ZAMAN degismeden gorunur. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- [ClickOnce - 2026-09-08] ClickOnce'a ozel ayarlar (surum, yayinci,
       guncelleme adresi, imzalama vb.) BURADA DEGIL,
       Properties/PublishProfiles/ClickOnce.pubxml icindedir - bu, Visual
       Studio'nun standart ClickOnce publish-profile semasidir ve mevcut
       taşınabilir "dotnet publish -r win-x64 (self contained true)" akisini
       (docs/DEPLOYMENT.md §1) hic etkilemez (profil yalnizca acikca
       "-p:PublishProfile=ClickOnce" verildiginde devreye girer). Detay/acik
       kararlar: docs/CLICKONCE.md. -->

</Project>
