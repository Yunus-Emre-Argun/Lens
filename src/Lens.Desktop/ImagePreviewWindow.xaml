<Window x:Class="Lens.Desktop.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Önizleme" Height="500" Width="600" MinHeight="280" MinWidth="360"
        WindowStartupLocation="CenterOwner" Background="#FF1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid ClipToBounds="True">
        <Border x:Name="ImageHost" Background="Transparent"
                MouseWheel="ImageHost_MouseWheel"
                MouseLeftButtonDown="ImageHost_MouseLeftButtonDown"
                MouseLeftButtonUp="ImageHost_MouseLeftButtonUp"
                MouseMove="ImageHost_MouseMove"
                MouseLeave="ImageHost_MouseLeave">
            <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PanTransform" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
        </Border>

        <TextBlock x:Name="TitleText" Text="" Foreground="White" FontSize="13" FontWeight="SemiBold"
                   Margin="14,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" />
        <TextBlock Text="Fare tekerleği: yakınlaştır/uzaklaştır  •  Sürükle: kaydır  •  Çift tık: sığdır  •  ESC: kapat"
                   Foreground="#FFAAAAAA" FontSize="11" Margin="0,0,14,10"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right" />
    </Grid>
</Window>
