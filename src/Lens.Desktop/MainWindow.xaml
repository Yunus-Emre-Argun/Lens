<Window x:Class="Lens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lens.Desktop"
        mc:Ignorable="d"
        Title="Lens - Ürün Görsel Arama (MVP)" Height="760" Width="1040" MinHeight="600" MinWidth="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Urun klasoru -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectFolderButton" Content="Ürün Klasörü Seç" Padding="10,4"
                    Margin="0,0,8,0" Click="SelectFolderButton_Click" />
            <TextBox x:Name="FolderPathTextBox" Width="520" IsReadOnly="True"
                     VerticalContentAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="ProductCountText" Text="Klasör seçilmedi" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock x:Name="DirectorySourceText" Text="" VerticalAlignment="Center"
                       Margin="12,0,8,0" FontStyle="Italic" Foreground="#FF777777" />
            <Button x:Name="SetDefaultButton" Content="Bu Klasörü Varsayılan Yap" Padding="8,2"
                    Margin="0,0,8,0" Click="SetDefaultButton_Click" IsEnabled="False" />
            <Button x:Name="ClearDefaultButton" Content="Varsayılanı Temizle" Padding="8,2"
                    Click="ClearDefaultButton_Click" Visibility="Collapsed" />
        </StackPanel>

        <!-- Index kontrolu -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="UpdateIndexButton" Content="İndeksi Güncelle / Klasörü Tara" Padding="10,4"
                    Margin="0,0,8,0" Click="UpdateIndexButton_Click" />
            <TextBlock x:Name="IndexStatusText" Text="—" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="ProblemFilesButton" Content="Sorunlu Dosyalar (0)" Padding="6,2"
                    Margin="12,0,0,0" Click="ProblemFilesButton_Click" Visibility="Collapsed" />
        </StackPanel>

        <!-- Query secimi -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="SelectQueryButton" Content="Sorgu Görseli Seç" Padding="10,4"
                    Margin="0,0,8,0" Click="SelectQueryButton_Click" />
            <Border BorderBrush="Gray" BorderThickness="1" Width="90" Height="90" Margin="0,0,8,0" Background="#FFF5F5F5">
                <Image x:Name="QueryPreviewImage" Stretch="Uniform" Margin="2" />
            </Border>
            <Button x:Name="SearchButton" Content="Ara" Padding="20,4" FontWeight="Bold"
                    VerticalAlignment="Center" Click="SearchButton_Click" />
        </StackPanel>

        <!-- Sonuclar -->
        <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsItemsControl" Margin="4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="8" Padding="8" Width="190">
                                <StackPanel>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Height="160" Background="#FFF5F5F5">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                                    </Border>
                                    <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Alt bilgi -->
        <TextBlock Grid.Row="4" Margin="0,8,0,0" FontStyle="Italic" Foreground="#FF555555"
                    Text="Sistem kesin eşleşme belirtmez; en yakın adaylar listelenir. Son kararı kullanıcı verir." />
    </Grid>
</Window>
