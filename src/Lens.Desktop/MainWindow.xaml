<Window x:Class="Lens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lens.Desktop"
        mc:Ignorable="d"
        Background="{DynamicResource MainBackgroundBrush}"
        Title="Lens - Ürün Görsel Arama (MVP)" Height="840" Width="1060" MinHeight="680" MinWidth="860">
    <Window.Resources>
        <!-- Sabit (temadan bagimsiz) renkler: mavi vurgu ve sorgu panelinin
             notr/koyu cercevesi TUM temalarda ayni kalir (bkz. talimat "Query'nin
             notr/koyu cercevesi ve secilen sonucun mavi vurgusu ayirt edilebilir
             kalmali"). Kart/gorsel yuzeyleri de her zaman beyaz kaldigindan bu
             renkler zeminden bagimsiz olarak calisir. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6FED" />
        <SolidColorBrush x:Key="AccentBrushLight" Color="#FFEAF1FE" />
        <SolidColorBrush x:Key="NeutralBorderBrush" Color="#FF3A3A3A" />

        <!-- Tema-bagimli renkler: baslangic degerleri "Normal" temasidir (bkz.
             Lens.Desktop.AppTheme/ThemePalette). MainWindow.SetTheme burada AYNI
             anahtarlari YENI SolidColorBrush nesneleriyle degistirir (Resources[key]=...)
             - DynamicResource kullanan her yerde (Style Setter'lari dahil) aninda
             gunceller. NeutralBackgroundBrush/kart ici metinler BU KAYNAKLARI
             KULLANMAZ (ayri, sabit kaynak - bkz. SelectableFileNameStyle varsayilan
             Foreground'u), boylece "kart ici koyu yazi" ile "ana zemin uzerindeki
             yazi" hep farkli kaynaklardan gelir. -->
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FF64748B" />
        <SolidColorBrush x:Key="NeutralTextBrush" Color="White" />
        <SolidColorBrush x:Key="SectionHeaderBrush" Color="White" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFDCE1E8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF7CE495" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFFF8A80" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="28,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Ana sorgu akisi (Sorgu Gorseli Sec / Yeni Arama) - veri/klasor
             yonetimi butonlarindan bilincli olarak daha buyuk/rahat, boylece
             kullanicinin tekrar tekrar dokundugu asil akis one cikar. -->
        <Style x:Key="QueryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Secilebilir/kopyalanabilir ama buton gibi davranmayan "duz metin" gorunumu -->
        <Style x:Key="SelectableFileNameStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF555555" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        </Style>

        <!-- Sonuc kart border stili: secili karta sade accent vurgusu -->
        <Style x:Key="ResultCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFBBBBBB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{StaticResource AccentBrushLight}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Buton varsayilan gorunumunu kaldirip sade, tiklanabilir bir kart yapan template -->
        <ControlTemplate x:Key="ResultCardButtonTemplate" TargetType="Button">
            <ContentPresenter />
        </ControlTemplate>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ust kontrol - Satir 1: klasor secimi + esneyen path + menu -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="SelectFolderButton" Content="Ürün Klasörü Seç" Padding="10,4"
                    Margin="0,0,8,0" Click="SelectFolderButton_Click" />
            <TextBox Grid.Column="1" x:Name="FolderPathTextBox" IsReadOnly="True"
                     VerticalContentAlignment="Center" Margin="0,0,8,0" Text="" />
            <Button Grid.Column="2" x:Name="MenuButton" Content="⋮" Padding="10,4" FontWeight="Bold"
                    Click="MenuButton_Click" ToolTip="Menü">
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="Ayarlar" Click="SettingsMenuItem_Click" />
                        <!-- [Tema turu] Alt menu Normal butondan ayri, "check" ile
                             hangi temanin secili oldugu her zaman gorunur (bkz.
                             MainWindow.UpdateThemeMenuChecks). Tag, ThemeMenuItem_Click
                             icinde AppTheme'e cevrilen sabit string anahtar. -->
                        <MenuItem Header="Arka Plan">
                            <MenuItem x:Name="ThemeMenuItem_Acik" Header="Açık" Tag="Acik"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_Normal" Header="Normal" Tag="Normal"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_Koyu" Header="Koyu" Tag="Koyu"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_AcikSepya" Header="Açık Sepya" Tag="AcikSepya"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_KoyuSepya" Header="Koyu Sepya" Tag="KoyuSepya"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_Lime" Header="Lime (Deneme)" Tag="Lime"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                        </MenuItem>
                        <MenuItem Header="Log Klasörünü Aç" Click="OpenLogFolderMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Hakkında" Click="AboutMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- Ust kontrol - Satir 2: urun sayisi/kaynak + varsayilan islemleri + index islemleri/status.
             WrapPanel BILEREK kullanildi (Grid Auto/Star DEGIL): iki taraftan biri (orn. uzun bir
             IndexStatusText) genislik istediginde Grid star-sutunu neredeyse sifira sikisip metni asiri
             sayida dar satira sarabiliyor, bu da butonlarin (varsayilan Stretch dikey hizalamayla)
             satir yuksekligine gore devasa kutulara donusmesine yol aciyordu (Faz 2 sirasinda dar
             pencerede gozlemlendi/duzeltildi). WrapPanel'de elemanlar asla sikismaz - yer kalmayinca
             sadece bir sonraki satira gecer. -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="ProductCountText" Text="Klasör seçilmedi" VerticalAlignment="Center" FontWeight="SemiBold"
                       Margin="0,0,0,6" Foreground="{DynamicResource NeutralTextBrush}" />
            <TextBlock x:Name="DirectorySourceText" Text="" VerticalAlignment="Center"
                       Margin="10,0,16,6" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" />
            <Button x:Name="SetDefaultButton" Content="Bu Klasörü Varsayılan Yap" Padding="8,2" VerticalAlignment="Center"
                    Margin="0,0,8,6" Click="SetDefaultButton_Click" IsEnabled="False" />
            <Button x:Name="ClearDefaultButton" Content="Varsayılanı Temizle" Padding="8,2" VerticalAlignment="Center"
                    Margin="0,0,24,6" Click="ClearDefaultButton_Click" Visibility="Collapsed" />

            <Button x:Name="UpdateIndexButton" Content="İndeksi Güncelle / Klasörü Tara" Padding="10,4" VerticalAlignment="Center"
                    Margin="0,0,10,6" Click="UpdateIndexButton_Click" />
            <TextBlock x:Name="IndexStatusText" Text="—" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                       Margin="0,0,10,6" Foreground="{DynamicResource NeutralTextBrush}" />
            <!-- ProblemFilesButton native (temadan bagimsiz, hep acik gri) buton
                 yuzeyi uzerinde durur - WarningBrush artik tema-bagimli oldugundan
                 buraya BILEREK sabit/hardcoded kirmizi kullanilir (aksi halde
                 Normal/Koyu/Sepya temalarinda acik yuzeyli butonda solgun/okunmaz
                 kalirdi). -->
            <Button x:Name="ProblemFilesButton" Content="Sorunlu / Atlanan Dosyalar (0)" Padding="6,2" VerticalAlignment="Center"
                    Margin="0,0,0,6" Click="ProblemFilesButton_Click" Visibility="Collapsed"
                    Foreground="#FFB00020" />
        </WrapPanel>

        <!-- Ust kontrol - Satir 3: ayrintili son basarili tarama istatistikleri (sifir sayimlar dahil, manager tam ozet ister) -->
        <TextBlock Grid.Row="2" x:Name="DetailedStatsText" Text="Henüz başarılı bir tarama yapılmadı."
                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,14" />

        <!-- Sorgu aksiyon cubugu: threshold + auto-index kontrolu ayni arama grubunda, Ara butonunun yaninda -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="SORGU VE KARŞILAŞTIRMA" Style="{StaticResource SectionHeaderStyle}" />
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="SelectQueryButton" Content="Sorgu Görseli Seç" Style="{StaticResource QueryActionButtonStyle}"
                        Margin="0,0,16,6" Click="SelectQueryButton_Click" />
                <Border BorderBrush="#FFD8D8D8" BorderThickness="1" Background="White" Padding="10,6" Margin="0,0,16,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Minimum benzerlik (%)" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="ThresholdTextBox" Width="60" VerticalContentAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="AutoIndexCheckBox" Content="Arama öncesi indeksi otomatik kontrol et ve güncelle"
                                  VerticalAlignment="Center" Checked="AutoIndexCheckBox_CheckedChanged" Unchecked="AutoIndexCheckBox_CheckedChanged" />
                    </StackPanel>
                </Border>
                <Button x:Name="SearchButton" Content="Ara" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,16,6" Click="SearchButton_Click" />
                <Button x:Name="NewSearchButton" Content="Yeni Arama" Style="{StaticResource QueryActionButtonStyle}"
                        Margin="0,0,0,6" Click="NewSearchButton_Click" />
            </WrapPanel>
            <TextBlock x:Name="ThresholdValidationText" Text="" Foreground="{DynamicResource WarningBrush}"
                       FontSize="11" Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Karsilastirma alani: sorgu + secilen sonuc TEK bir grup olarak pencerede
             birlikte ortalanir (dis Grid'in kendisi HorizontalAlignment=Center ile
             sadece grubun dogal genisligi (220+40+220) kadar yer kaplar - iki ayri
             "*" sutunda BAGIMSIZ ortalama DEGIL, boylece pencere genisledikce
             aradaki 40 DIP sabit kalir, fazla alan grubun disina/iki yanina esit
             dagilir). Auto+sabit+Auto sutunlari: ortadaki bosluk sutunu icerik
             tasimaz, sadece mesafe verir. -->
        <Grid Grid.Row="4" Margin="0,0,0,14" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Sorgulanan Görsel" FontWeight="SemiBold" Margin="0,0,0,4" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeutralTextBrush}" />
                <Border x:Name="QueryDropZone" BorderBrush="{StaticResource NeutralBorderBrush}" BorderThickness="2" Width="220" Height="220"
                        Background="White" AllowDrop="True" Cursor="Hand"
                        DragEnter="QueryDropZone_DragEnter" DragOver="QueryDropZone_DragOver"
                        DragLeave="QueryDropZone_DragLeave"
                        Drop="QueryDropZone_Drop" MouseLeftButtonDown="QueryDropZone_MouseLeftButtonDown">
                    <Image x:Name="QueryPreviewImage" Stretch="Uniform" Margin="4" />
                </Border>
                <TextBox x:Name="QueryFileNameText" Text="" Width="220" Style="{StaticResource SelectableFileNameStyle}" TextAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="QueryDropHintText" Text="Görsel seçin veya buraya sürükleyin  •  çift tık: büyüt" FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Width="220" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Seçilen Sonuç" FontWeight="SemiBold" Margin="0,0,0,4" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeutralTextBrush}" />
                <Border x:Name="ComparisonResultBorder" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Width="220" Height="220"
                        Background="White" Cursor="Hand" MouseLeftButtonDown="ComparisonResultBorder_MouseLeftButtonDown">
                    <Image x:Name="ComparisonResultImage" Stretch="Uniform" Margin="4" />
                </Border>
                <TextBox x:Name="ComparisonFileNameText" Text="" Width="220" Style="{StaticResource SelectableFileNameStyle}" TextAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="ComparisonScoreText" Text="" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeutralTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- Sonuclar: Grid (Auto baslik + * viewport) - StackPanel'DEN BILEREK cikarildi, cunku StackPanel
             ic ScrollViewer'a hicbir zaman sinirli (bounded) bir yukseklik vermez (icerik Grid satiri
             tarafindan gorsel olarak kirpilirdi, gercek scroll calismazdi). Grid'in "*" satiri
             ScrollViewer'a kalan tum yuksekligi verir, boylece tekerlek ile TUM 15 karta erisilebilir. -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="EN BENZER SONUÇLAR (EN FAZLA 15)" Style="{StaticResource SectionHeaderStyle}" />
            <!-- Background BILEREK yok (transparan) - dolu/az sonuclu durumda kartlarin
                 ALTINDAKI/ETRAFINDAKI bos alan artik ana pencere zemini ile birlesir
                 (buyuk sabit beyaz blok kaldirildi). Kartlarin kendisi (ResultCardBorderStyle)
                 hala saf beyaz - zeminden ayrisir. Ince BorderBrush yalnizca viewport'un
                 sinirini gostermek icin kalir, tema-bagimsiz notr gri. -->
            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
                <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto">
                    <!-- VerticalAlignment=Top: ItemsControl/UniformGrid artik ScrollViewer'in
                         verdigi TUM kalan yuksekligi doldurmaya ZORLANMIYOR - yalnizca
                         kartlarin DOGAL (icerige gore) yuksekligini kaplar ve viewport'un
                         USTUNE hizalanir. Bu, az sonucta (orn. 1-2 kart) secili kartin mavi
                         cercevesinin/arka planinin bos alani doldurmak icin asagiya dogru
                         gereksiz uzamasinin KOK NEDENIYDI (UniformGrid, kendisine verilen
                         ARRANGE boyutunu satir sayisina bolerek hucre yuksekligini hesaplar -
                         Stretch ile bu boyut viewport'un tamamiydi). Yatay eksen etkilenmez,
                         5 sutun hala mevcut genisligi paylasir (kapsamli responsive redesign
                         yapilmadi). -->
                    <ItemsControl x:Name="ResultsItemsControl" Margin="4" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Disari tasindi: dosya adi artik Button'un DISINDA, boylece metin
                                     secimi/kopyalama kartin tek-tik secim davranisiyla catismiyor.
                                     Buton yalnizca thumbnail'i sarar - "kartin gorseli" tek tik hedefi. -->
                                <Border Style="{StaticResource ResultCardBorderStyle}" Padding="6" Margin="6">
                                    <StackPanel>
                                        <Button Click="ResultCard_Click" MouseDoubleClick="ResultCard_DoubleClick"
                                                Template="{StaticResource ResultCardButtonTemplate}" Cursor="Hand">
                                            <Border BorderBrush="LightGray" BorderThickness="1" Height="110" Background="White">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                                            </Border>
                                        </Button>
                                        <TextBox Text="{Binding FileName, Mode=OneWay}"
                                                 Style="{StaticResource SelectableFileNameStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Alt bilgi: artik ayri bir acik panel/blok degil - ana pencere zeminiyle
             birlesir, metin rengi DynamicResource ile temaya gore okunabilir kalir. -->
        <TextBlock Grid.Row="6" Margin="0,8,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="Sistem kesin eşleşme belirtmez; en yakın adaylar listelenir. Son kararı kullanıcı verir." />
    </Grid>
</Window>
