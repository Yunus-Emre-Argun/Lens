<Window x:Class="Lens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lens.Desktop"
        mc:Ignorable="d"
        Background="{DynamicResource MainBackgroundBrush}"
        Title="Lens - Ürün Görsel Arama (MVP)" Height="840" Width="1060" MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Sabit (temadan bagimsiz) renkler: mavi vurgu ve sorgu panelinin
             notr/koyu cercevesi TUM temalarda ayni kalir (bkz. talimat "Query'nin
             notr/koyu cercevesi ve secilen sonucun mavi vurgusu ayirt edilebilir
             kalmali"). Kart/gorsel yuzeyleri de her zaman beyaz kaldigindan bu
             renkler zeminden bagimsiz olarak calisir. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF2F6FED" />
        <SolidColorBrush x:Key="AccentBrushLight" Color="#FFEAF1FE" />
        <SolidColorBrush x:Key="NeutralBorderBrush" Color="#FF3A3A3A" />
        <!-- [Yerlesim - deney, sorgu/sonuc bos-durum metni] QueryDropZone/ComparisonResultBorder
             zemini yukarida aciklandigi gibi HER TEMADA sabit beyaz kalir - bu yuzden uzerlerindeki
             bos-durum metinleri de (SelectableFileNameStyle'daki dosya adi metniyle AYNI mantik)
             ana pencere zeminine gore degisen SecondaryTextBrush DEGIL, beyaz zeminde HER temada
             okunabilir SABIT bir renk kullanir. Rastgele XAML'e serpistirilmis ciplak hex DEGIL -
             diger "sabit/temadan bagimsiz" kaynaklarla (AccentBrush, NeutralBorderBrush) AYNI
             blokta, adlandirilmis tek bir kaynak. -->
        <SolidColorBrush x:Key="CardSecondaryTextBrush" Color="#FF6B6B6B" />

        <!-- Tema-bagimli renkler: baslangic degerleri "Normal" temasidir (bkz.
             Lens.Desktop.AppTheme/ThemePalette). MainWindow.SetTheme burada AYNI
             anahtarlari YENI SolidColorBrush nesneleriyle degistirir (Resources[key]=...)
             - DynamicResource kullanan her yerde (Style Setter'lari dahil) aninda
             gunceller. NeutralBackgroundBrush/kart ici metinler BU KAYNAKLARI
             KULLANMAZ (ayri, sabit kaynak - bkz. SelectableFileNameStyle varsayilan
             Foreground'u), boylece "kart ici koyu yazi" ile "ana zemin uzerindeki
             yazi" hep farkli kaynaklardan gelir. -->
        <SolidColorBrush x:Key="MainBackgroundBrush" Color="#FF64748B" />
        <SolidColorBrush x:Key="NeutralTextBrush" Color="White" />
        <SolidColorBrush x:Key="SectionHeaderBrush" Color="White" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFDCE1E8" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF7CE495" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFFF8A80" />
        <!-- [Yerlesim - deney, Arama Ayarlari paneli] Bu ikisi de MainWindow.SetTheme
             tarafindan (diger tema-bagimli kaynaklarla AYNI yerde) ana pencere zemininden
             (MainBackground) TURETILEREK yeniden atanir - AppTheme.cs/ThemePalette'e YENI
             renk EKLENMEDI (talimat: "tema paletleri" bu gorev kapsaminda degistirilmeyecek).
             Buradaki degerler yalnizca ilk XAML render'i icin "Normal" tema varsayilanidir. -->
        <SolidColorBrush x:Key="SettingsPanelBackgroundBrush" Color="#1F000000" />
        <SolidColorBrush x:Key="SettingsPanelBorderBrush" Color="#FFDCE1E8" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="28,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Ana sorgu akisi (Sorgu Gorseli Sec / Yeni Arama) - veri/klasor
             yonetimi butonlarindan bilincli olarak daha buyuk/rahat, boylece
             kullanicinin tekrar tekrar dokundugu asil akis one cikar. -->
        <Style x:Key="QueryActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Secilebilir/kopyalanabilir ama buton gibi davranmayan "duz metin" gorunumu -->
        <Style x:Key="SelectableFileNameStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF555555" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        </Style>

        <!-- Sonuc kart border stili: secili karta sade accent vurgusu -->
        <Style x:Key="ResultCardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFBBBBBB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{StaticResource AccentBrushLight}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Buton varsayilan gorunumunu kaldirip sade, tiklanabilir bir kart yapan template -->
        <ControlTemplate x:Key="ResultCardButtonTemplate" TargetType="Button">
            <ContentPresenter />
        </ControlTemplate>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- [Yerlesim - Eylul 2026 ust satir taslak hizalama duzeltmesi] Ust iki satir TEK
             bir Grid (TopAreaGrid) - iki ayri Grid yerine ORTAK sutun tanimlari kullanilir ki
             "Bu Klasoru Varsayilan Yap" (satir0, sutun4) ile "Sorunlu / Atlanan Dosyalar"
             (satir1, sutun4) sol kenarlari HER ZAMAN garanti ayni olsun - bu, iki bagimsiz
             Grid'de "ikisi de sagda" tahminiyle YAPILAMAYACAK kadar kesin bir sart oldugu
             icin BILEREK boyle kuruldu. 8 sutun: [0]SelectFolderColumn [1]FolderPathColumn
             [2]ProductInfoColumn [3]DefaultGroupSpacerColumn [4]DefaultGroupColumn(SetDefault+
             ProblemFiles) [5]ClearDefaultColumn [6]MenuSpacerColumn [7]MenuColumn.
             DefaultGroupSpacerColumn(3) genisligi hala MainWindow.UpdateResponsiveLayout
             tarafindan KOD ILE ayarlanir - sabit "*" DEGIL, boylece varsayilan buton grubunun
             sol baslangici genis pencerede karsilastirma satirindaki sag gorselin sol kenari
             CIVARINDA kalir (pencerenin ham sag kösesine yapismaz) - olculen deger, tahmin
             edilen sabit bir margin DEGILDIR. MenuSpacerColumn(6) ise GERCEK bir "*" sutun -
             kod tarafindan HIC ayarlanmaz, WPF Grid motoru kendisi buyur/kuculur - boylece
             MenuButton(7) HER ZAMAN TopAreaGrid'in (dolayisiyla RootGrid'in) en sag kenarinda
             kalir (kullanicinin guncel/kesin talimati: "⋮ menüsü pencerenin en sağında
             olmalıdır" - eski "sag kösesine yapismaz" notu YALNIZCA varsayilan buton grubu
             icin gecerlidir, menu icin ARTIK GECERSIZ). FolderPathTextBox(1) TUM pencere
             genisligine uzayan bir "*" sutunu DEGIL - MinWidth/MaxWidth ile sinirli, hedef
             genisligi UpdateResponsiveLayout tarafindan pencere genisligine gore KOD ILE
             (Lerp) ayarlanir; dar pencerede ilk kisalan alan budur. DefaultGroupColumn(4)/
             ClearDefaultColumn(5)/MenuColumn(7) HER ZAMAN Auto (dogal boyut) - hicbir kosulda
             kirpilmaz/kucculmez. -->
        <Grid Grid.Row="0" x:Name="TopAreaGrid" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SelectFolderColumn" Width="Auto" />
                <ColumnDefinition x:Name="FolderPathColumn" Width="380" MinWidth="180" MaxWidth="560" />
                <ColumnDefinition x:Name="ProductInfoColumn" Width="Auto" />
                <ColumnDefinition x:Name="DefaultGroupSpacerColumn" Width="40" />
                <ColumnDefinition x:Name="DefaultGroupColumn" Width="Auto" />
                <ColumnDefinition x:Name="ClearDefaultColumn" Width="Auto" />
                <ColumnDefinition x:Name="MenuSpacerColumn" Width="*" />
                <ColumnDefinition x:Name="MenuColumn" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- [Klasor adresi elle girme] Varsayilan Collapsed - taslak/hata YOKKEN sifir
                     yukseklik kaplar, mevcut onaylanmis davranisi ETKILEMEZ. -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Satir 0: tarama klasoru secimi + adres + urun sayisi/kaynak solda, varsayilan
                 islemleri + menu sagda. Kontroller ~34 DIP yukseklikte (MinHeight) okunakli
                 ve hizali. -->
            <Button Grid.Row="0" Grid.Column="0" x:Name="SelectFolderButton" Content="Tarama Klasörünü Seç" Padding="10,4" MinHeight="34"
                    VerticalAlignment="Center" Margin="0,0,10,10" Click="SelectFolderButton_Click" />
            <!-- [Klasor adresi elle girme] Gercek adres degeri hicbir sekilde kesilmez/
                 degistirilmez - TextBox'in GORUNTULENEN genisligi kutu boyudur, metnin
                 kendisi (Text/kopyalama/duzenleme) etkilenmez. IsReadOnly artik SABIT
                 True DEGIL - MainWindow.SetBusy tarafindan yalnizca islem surerken
                 (arama/indeksleme/klasor yukleme) gecici olarak acilir (bkz. o metot -
                 IsEnabled BILEREK kullanilmadi, boylece mesgulken de secim/kopyalama
                 calismaya devam eder). Enter: taslagi dogrula/uygula (ayni Enter aramayi
                 BASLATMAZ). Esc: aktif klasore don. -->
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FolderPathTextBox" MinHeight="34"
                     VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,10" Text=""
                     TextChanged="FolderPathTextBox_TextChanged" PreviewKeyDown="FolderPathTextBox_PreviewKeyDown"
                     ToolTip="Klasör adresini yazabilir veya yapıştırabilirsiniz. Uygulamak için Enter, iptal etmek için Esc." />
            <!-- [Ust satir sinir-durumu duzeltmesi] ProductInfoPanel.MaxWidth, MainWindow.
                 UpdateResponsiveLayout tarafindan pencere genisligine gore KOD ILE ayarlanir
                 (860 DIP minimumda sikisik ~160 DIP, genis pencerede pratikte sinirsiz ~600 DIP).
                 WrapPanel kendi MaxWidth'i asildiginda COCUKLARI (ProductCountText/
                 DirectorySourceText) alt alta SARAR (ikisi de tek satirlik dogal genislikleriyle
                 kalir - WrapPanel her cocugu OLCERKEN sinirsiz genislik verir, yani TEK bir
                 cocugun kendi ICINDE kelime kelime sarilmasini SAGLAMAZ; bu satirdaki gercek
                 metinler (urun sayisi + sabit kisa kaynak etiketleri) tek basina bu 160 DIP
                 sinirinin altinda kaldigindan bu yeterli - bkz. FormattedText ile olculen
                 gercek genislikler). Amac SADECE en dar pencerede "Bu Klasörü Varsayılan Yap"/
                 "Varsayılanı Temizle"/MenuButton'u disariya itebilecek toplam genisligi
                 sinirlamak. Metin icerigi/kaynak mantigi DEGISMEDI. -->
            <WrapPanel Grid.Row="0" Grid.Column="2" x:Name="ProductInfoPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock x:Name="ProductCountText" Text="Klasör seçilmedi" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource NeutralTextBrush}" />
                <TextBlock x:Name="DirectorySourceText" Text="" VerticalAlignment="Center" FontSize="13"
                           Margin="10,0,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryTextBrush}" />
            </WrapPanel>
            <!-- Sutun 3: bosluk - genisligi kod ile ayarlanir (bkz. yukaridaki not). -->
            <Button Grid.Row="0" Grid.Column="4" x:Name="SetDefaultButton" Content="Bu Klasörü Varsayılan Yap" Padding="8,2" MinHeight="34"
                    VerticalAlignment="Center" Margin="0,0,8,10" Click="SetDefaultButton_Click" IsEnabled="False" />
            <Button Grid.Row="0" Grid.Column="5" x:Name="ClearDefaultButton" Content="Varsayılanı Temizle" Padding="8,2" MinHeight="34"
                    VerticalAlignment="Center" Margin="0,0,8,10" Click="ClearDefaultButton_Click" Visibility="Collapsed" />
            <Button Grid.Row="0" Grid.Column="7" x:Name="MenuButton" Content="⋮" Padding="10,4" FontWeight="Bold" MinHeight="34"
                    VerticalAlignment="Center" Margin="0,0,0,10" Click="MenuButton_Click" ToolTip="Menü">
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Header="Bilgilendirme" Click="SettingsMenuItem_Click" />
                        <!-- [Tema turu] Alt menu Normal butondan ayri, "check" ile
                             hangi temanin secili oldugu her zaman gorunur (bkz.
                             MainWindow.UpdateThemeMenuChecks). Tag, ThemeMenuItem_Click
                             icinde AppTheme'e cevrilen sabit string anahtar. -->
                        <MenuItem Header="Arka Plan">
                            <MenuItem x:Name="ThemeMenuItem_Acik" Header="Açık" Tag="Acik"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_Normal" Header="Normal" Tag="Normal"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_Koyu" Header="Koyu" Tag="Koyu"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_AcikSepya" Header="Açık Sepya" Tag="AcikSepya"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_KoyuSepya" Header="Koyu Sepya" Tag="KoyuSepya"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                            <MenuItem x:Name="ThemeMenuItem_Lime" Header="Lime" Tag="Lime"
                                      IsCheckable="True" Click="ThemeMenuItem_Click" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Hakkında" Click="AboutMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Satir 1 (Grid.ColumnSpan=4, sutun 0-3'u kapsar): adres taslak/hata ipucu -
                 Collapsed iken SIFIR yukseklik, mevcut yerlesimi ETKILEMEZ. -->
            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="FolderPathHintText" Text="" Visibility="Collapsed"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                       Foreground="{DynamicResource SecondaryTextBrush}" />

            <!-- Satir 2: indeksleme islemi + durum/istatistik solda (sutun 0-3'u kapsar),
                 "Sorunlu / Atlanan Dosyalar" sagda - SetDefaultButton (satir0, sutun4) ile
                 AYNI sutunda, dolayisiyla sol kenarlari HER ZAMAN AYNI (KESIN sart, bkz.
                 yukaridaki not). VerticalAlignment="Top" acikca belirtildi: IndexStatusText/
                 DetailedStatsText uzun metinde birden fazla satira sarabilir - bu satir Auto
                 yukseklikte oldugunda, varsayilan Stretch hizalamayla ProblemFilesButton/
                 UpdateIndexButton satir yuksekligine gore devasa bir kutuya donusebilirdi
                 (Faz 2'de WrapPanel'e gecisin asil nedeni buydu); Top hizalama bu riski Grid
                 kullanirken de ortadan kaldirir. Mevcut gorunurluk kurallari DEGISMEDI:
                 ProblemFilesButton sorun yoksa Collapsed kalir (UpdateProblemFilesUi),
                 DetailedStatsText henuz basarili tarama yoksa Collapsed kalir (UpdateStatsUi). -->
            <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="UpdateIndexButton" Content="İndeksi Güncelle / Klasörü Tara" Padding="10,4" MinHeight="34" VerticalAlignment="Center"
                        Margin="0,0,10,6" Click="UpdateIndexButton_Click" />
                <TextBlock x:Name="IndexStatusText" Text="—" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" MaxWidth="380"
                           Margin="0,0,10,6" Foreground="{DynamicResource NeutralTextBrush}" />
                <!-- Ayrintili son basarili tarama istatistikleri (sifir sayimlar dahil, manager tam
                     ozet ister). Bu oturumda secili klasor icin henuz basarili bir tarama yoksa
                     Collapsed (bkz. MainWindow.UpdateStatsUi) - Collapsed, WrapPanel icinde gercekten
                     SIFIR yer kaplar, bos bir mesaj/bosluk BIRAKMAZ. -->
                <TextBlock x:Name="DetailedStatsText" Text="" Visibility="Collapsed" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6" />
            </WrapPanel>
            <!-- ProblemFilesButton native (temadan bagimsiz, hep acik gri) buton
                 yuzeyi uzerinde durur - WarningBrush artik tema-bagimli oldugundan
                 buraya BILEREK sabit/hardcoded kirmizi kullanilir (aksi halde
                 Normal/Koyu/Sepya temalarinda acik yuzeyli butonda solgun/okunmaz
                 kalirdi). -->
            <Button Grid.Row="2" Grid.Column="4" x:Name="ProblemFilesButton" Content="Sorunlu / Atlanan Dosyalar (0)" Padding="6,2" MinHeight="30"
                    VerticalAlignment="Top" Click="ProblemFilesButton_Click" Visibility="Collapsed"
                    Foreground="#FFB00020" />
        </Grid>

        <!-- [Yerlesim - deney, sorgu/ayar/sonuc yeniden duzeni] Orta blok: sorgu gorseli ->
             Ara/Yeni Arama + Arama Ayarlari paneli (SettingsButtonsGrid, tek alt Grid) ->
             secilen sonuc gorseli, TEK bir grup olarak pencerede birlikte ortalanir (dis
             Grid'in kendisi HorizontalAlignment=Center ile sadece grubun dogal genisligi
             kadar yer kaplar, boylece pencere genisledikce fazla alan grubun İKİ YANINA esit
             dagilir). "SORGU VE KARŞILAŞTIRMA" genel basligi BILEREK YOK (kullanici talimati) -
             "Sorgulanan Görsel"/"Seçilen Sonuç" alt basliklari korunuyor. Bes sutun: [0]gorsel
             [1]ComparisonGapLeftColumn(bosluk) [2]SettingsButtonsGrid [3]ComparisonGapRightColumn
             (bosluk) [4]gorsel. Gorsel kutulari ARTIK KARE DEGIL, 4:3 yatay dikdortgen (bkz.
             MainWindow.UpdateResponsiveLayout - imageWidth pencere genisligine, imageHeight =
             imageWidth*0.75'e gore KOD ILE ayarlanir, ayrica kullanilabilir YUKSEKLIK de hesaba
             katilir ki sonuc alani ezilmesin). Ust/alt Margin, eski kare yerlesime gore
             kucultuldu (32/20 -> 20/12) - kazanilan dikey alanin cogu ZATEN 300->240 (genis
             pencerede) yukseklik azalmasindan gelir, bu sadece ek bir katki. Bir
             RenderTransform/Viewbox KULLANILMADI ki surukle-birak hit-testing ve cift-tik
             buyutme davranisi hicbir sekilde etkilenmesin. -->
        <Grid x:Name="ComparisonRowGrid" Grid.Row="1" Margin="0,20,0,12" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ComparisonGapLeftColumn" Width="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ComparisonGapRightColumn" Width="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sorgulanan görsel - 320x240 (genis pencere hedefi, 4:3), MainWindow.
                 UpdateResponsiveLayout tarafindan pencere genisligi+yuksekligine gore KOD ILE
                 ayarlanir. Ayri "Sorgu Görseli Seç" butonu KALDIRILDI (talimat) - bos cerceve
                 artik KENDISI tiklanabilir (bkz. QueryDropZone_MouseLeftButtonDown/_KeyDown):
                 gorsel yokken tek tik/Enter/Space dosya sec, gorsel VARKEN tek tik yalnizca
                 odaklanir (cift-tikla onizlemeyi bozmamak icin), cift tik her zaman buyuk
                 onizleme acar. QueryEmptyStatePanel, cercevenin USTUNE binen ayri bir Grid
                 katmani - IsHitTestVisible=False ile tiklama/surukle-birak'i HICBIR SEKILDE
                 engellemez, yalnizca METINLERE Opacity uygulanir (cercevenin/gorselin kendisi
                 DEGIL). Renk kasitli olarak SecondaryTextBrush DEGIL, CardSecondaryTextBrush -
                 cerceve zemini her temada sabit BEYAZ kaldigindan (bkz. yukaridaki kaynak
                 yorumu). -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Sorgulanan Görsel" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeutralTextBrush}" />
                <Grid>
                    <Border x:Name="QueryDropZone" BorderBrush="{StaticResource NeutralBorderBrush}" BorderThickness="2" Width="320" Height="240"
                            Background="White" AllowDrop="True" Cursor="Hand" Focusable="True"
                            AutomationProperties.Name="Sorgu görseli seç veya sürükleyip bırakın"
                            DragEnter="QueryDropZone_DragEnter" DragOver="QueryDropZone_DragOver"
                            DragLeave="QueryDropZone_DragLeave"
                            Drop="QueryDropZone_Drop" MouseLeftButtonDown="QueryDropZone_MouseLeftButtonDown"
                            KeyDown="QueryDropZone_KeyDown">
                        <Image x:Name="QueryPreviewImage" Stretch="Uniform" Margin="4" />
                    </Border>
                    <StackPanel x:Name="QueryEmptyStatePanel" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Sorgu görselini seçin" FontSize="15" FontWeight="SemiBold" Opacity="0.55"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource CardSecondaryTextBrush}" />
                        <TextBlock Text="Tıklayın veya buraya sürükleyin" FontSize="11" Opacity="0.55" Margin="0,4,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource CardSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="QueryFileNameText" Text="" Width="320" Style="{StaticResource SelectableFileNameStyle}" TextAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
                <!-- [Kalici kullanim bilgisi - KORUNDU] Kullanici bu satirin, cerceve icindeki
                     yeni empty-state ile "tekrar" olusturdugu bilinerek ozellikle korunmasini
                     istedi - kaldirilmadi. -->
                <TextBlock x:Name="QueryDropHintText" Text="Görsel seçin veya buraya sürükleyin  •  çift tık: büyüt" FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextAlignment="Center" TextWrapping="Wrap" Width="320" />
            </StackPanel>

            <!-- Sutun 1: bosluk (~40 DIP genis pencerede, dar pencerede kucculur - bkz. UpdateResponsiveLayout) -->

            <!-- [Yerlesim - deney] Ara/Yeni Arama butonlari + Arama Ayarlari paneli TEK bir alt
                 Grid (SettingsButtonsGrid). Eskiden burada tek basina duran "Sorgu Görseli Seç"
                 butonunun YERINE, eski uc/dort sutunlu duz yerlesim yerine ARTIK iki katman var:
                 (1) satir 0 - Ara/Yeni Arama, iki ESIT ("*") sutun ile YAN YANA - Grid'in star
                 sutunlandirmasi genislik esitligini GARANTI eder (tahmini/manuel bolme DEGIL);
                 (2) satir 2 - "ARAMA AYARLARI" baslikli bir Border icinde threshold/max-sonuc/
                 checkbox, ayni Ara/Yeni Arama ile AYNI toplam genislikte (Grid.ColumnSpan=3) -
                 boylece iki buton ve altindaki panel GERCEKTEN tek bir sutun gibi hizali.
                 SettingsButtonsGrid.Width, MainWindow.UpdateResponsiveLayout tarafindan TEK bir
                 pencere-genisligi hesabiyla (eski settingsColumnWidth+gapInner+buttonWidth
                 TOPLAMIYLA AYNI butce - ust satirdaki varsayilan-buton-grubu hizalama hesabi
                 BURADAN ETKILENMEDI/DEGISMEDI) atanir. -->
            <Grid x:Name="SettingsButtonsGrid" Grid.Column="2" VerticalAlignment="Top" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsButtonsGapColumn" Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Satir 0: Ara / Yeni Arama - esit genislik (star sutunlar), ayni yukseklik (42 DIP,
                     eski Sorgu Görseli Seç/Ara ile AYNI sabit yukseklik - talimat "girislerin
                     yuksekligi sabit kalir" burada da gecerli). Click olaylari/stiller AYNEN korundu. -->
                <Button Grid.Row="0" Grid.Column="0" x:Name="SearchButton" Content="Ara" Style="{StaticResource PrimaryButtonStyle}"
                        Height="42" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="SearchButton_Click" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="NewSearchButton" Content="Yeni Arama" Style="{StaticResource QueryActionButtonStyle}"
                        Height="42" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" Click="NewSearchButton_Click" />

                <!-- Satir 1: sabit 10 DIP bosluk (icerik yok). -->

                <!-- Satir 2: "ARAMA AYARLARI" paneli - butonlarin TOPLAM genisligiyle AYNI
                     (ColumnSpan=3). Zemin/kenarlik SettingsPanelBackgroundBrush/
                     SettingsPanelBorderBrush - ikisi de MainWindow.SetTheme icinde ana pencere
                     zemininden turetilir (bkz. Resources yorumu), sabit beyaz/gri DEGIL. -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{DynamicResource SettingsPanelBackgroundBrush}"
                        BorderBrush="{DynamicResource SettingsPanelBorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="14,10,14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Etiket sutunu "*" - kalan TUM genisligi alir, boylece sayisal
                                 giris kutusunun (asagida) SABIT/kompakt genisligi disinda kalan
                                 alani otomatik doldurur (manuel Label=Toplam-Giris hesabi ARTIK
                                 GEREKMIYOR). -->
                            <ColumnDefinition Width="*" />
                            <!-- [Sayisal kutu genisligi - deney] Talimat: "yaklasik 52-60 DIP,
                                 uc rakamin rahatca sigacagi kompakt genislik". 56 DIP, bu araligin
                                 ortasi - pencere genisligiyle DEGISMEZ (digerlerinin aksine BILEREK
                                 lerp EDILMEDI, talimatta bu kutu icin ayri dar/genis tablosu
                                 verilmedi - tek, sabit "kompakt" hedef var). ThresholdTextBox/
                                 MaxResultsTextBox AYNI sutunu paylastigi icin genislikleri HER ZAMAN
                                 esit. -->
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="ARAMA AYARLARI" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{DynamicResource NeutralTextBrush}" />
                        <!-- Satir 1: sabit 8 DIP bosluk. -->

                        <!-- Satir 2: Minimum benzerlik. Etiketin sag Margin'i (0,0,10,0) ile giris
                             kutusunun sutun sinirina kadar ~10 DIP bosluk birakilir - TextBox'in
                             KENDISI 0 sol-margin ile Column=1'i TAM doldurur. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Minimum benzerlik (%)" VerticalAlignment="Center" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,10,0"
                                   Foreground="{DynamicResource NeutralTextBrush}" />
                        <!-- [Sayısal giriş - 2026-09-07, DEĞİŞTİRİLMEDİ] Harf/geçersiz karakter yazma
                             VE yapıştırma PreviewTextInput + DataObject.Pasting ile ENGELLENİR (bkz.
                             MainWindow.NumericTextBox_PreviewTextInput/_Pasting - karar mantığı
                             Lens.Core.Search.NumericInputFilter'da, WPF'siz test edilebilir).
                             TextChanged, IME/beklenmedik giriş yollarına karşı SON güvenlik ağıdır. -->
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ThresholdTextBox" MinHeight="36" VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting"
                                 TextChanged="NumericTextBox_TextChanged" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ThresholdValidationText" Text="" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                        <!-- Satir 4: sabit 8 DIP bosluk. -->

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="En fazla sonuç" VerticalAlignment="Center" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,0,10,0"
                                   Foreground="{DynamicResource NeutralTextBrush}" />
                        <!-- [Sayısal giriş - 2026-09-07, DEĞİŞTİRİLMEDİ] ThresholdTextBox ile AYNI
                             ortak filtre - allowDecimal=false (yalnızca tam sayı). -->
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="MaxResultsTextBox" MinHeight="36" VerticalContentAlignment="Center"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                 PreviewTextInput="NumericTextBox_PreviewTextInput" DataObject.Pasting="NumericTextBox_Pasting"
                                 TextChanged="NumericTextBox_TextChanged" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" x:Name="MaxResultsValidationText" Text="" Foreground="{DynamicResource WarningBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                        <!-- Satir 7: sabit 10 DIP bosluk. -->

                        <!-- Satir 8: otomatik indeks kutucuğu - panelin TAM genisligini kaplar
                             (ColumnSpan=2), Width sabiti KALDIRILDI - artik panelin gercek ic
                             genisligine gore SARAR (iki satira kadar - talimat "3+ satira
                             bolunmemeli" ile kompakt panel eninde dogal olarak uyumlu). -->
                        <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" x:Name="AutoIndexCheckBox" VerticalAlignment="Center"
                                  Checked="AutoIndexCheckBox_CheckedChanged" Unchecked="AutoIndexCheckBox_CheckedChanged">
                            <TextBlock Text="Arama öncesi indeksi otomatik kontrol et ve güncelle" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{DynamicResource NeutralTextBrush}" />
                        </CheckBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sutun 3: bosluk (~40 DIP genis pencerede, dar pencerede kucculur) -->

            <!-- Seçilen sonuç - sorgu görseliyle EŞİT 320x240 (4:3, bkz. yukaridaki not). -->
            <StackPanel Grid.Column="4">
                <TextBlock Text="Seçilen Sonuç" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeutralTextBrush}" />
                <Grid>
                    <Border x:Name="ComparisonResultBorder" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Width="320" Height="240"
                            Background="White" Cursor="Hand" MouseLeftButtonDown="ComparisonResultBorder_MouseLeftButtonDown">
                        <Image x:Name="ComparisonResultImage" Stretch="Uniform" Margin="4" />
                    </Border>
                    <!-- [Bos-durum, deney] Sonuc secilmemisken sade/yari saydam ipucu -
                         CardSecondaryTextBrush ile AYNI gerekce (cerceve zemini sabit beyaz). -->
                    <TextBlock x:Name="ComparisonEmptyStateText" Text="Henüz sonuç seçilmedi" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Opacity="0.55"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource CardSecondaryTextBrush}" />
                </Grid>
                <TextBox x:Name="ComparisonFileNameText" Text="" Width="320" Style="{StaticResource SelectableFileNameStyle}" TextAlignment="Center"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="ComparisonScoreText" Text="" FontWeight="Bold" FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource NeutralTextBrush}" />
            </StackPanel>
        </Grid>

        <!-- Sonuclar: Grid (Auto baslik + * viewport) - StackPanel'DEN BILEREK cikarildi, cunku StackPanel
             ic ScrollViewer'a hicbir zaman sinirli (bounded) bir yukseklik vermez (icerik Grid satiri
             tarafindan gorsel olarak kirpilirdi, gercek scroll calismazdi). Grid'in "*" satiri
             ScrollViewer'a kalan tum yuksekligi verir, boylece tekerlek ile TUM karta (en fazla
             SimilaritySearch.MaxResults kadar) erisilebilir. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="ResultsHeaderText" Text="EN BENZER SONUÇLAR (0)" Style="{StaticResource SectionHeaderStyle}" />
            <!-- Background BILEREK yok (transparan) - dolu/az sonuclu durumda kartlarin
                 ALTINDAKI/ETRAFINDAKI bos alan artik ana pencere zemini ile birlesir
                 (buyuk sabit beyaz blok kaldirildi). Kartlarin kendisi (ResultCardBorderStyle)
                 hala saf beyaz - zeminden ayrisir. Ince BorderBrush yalnizca viewport'un
                 sinirini gostermek icin kalir, tema-bagimsiz notr gri. -->
            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1">
                <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto">
                    <!-- VerticalAlignment=Top: ItemsControl/UniformGrid artik ScrollViewer'in
                         verdigi TUM kalan yuksekligi doldurmaya ZORLANMIYOR - yalnizca
                         kartlarin DOGAL (icerige gore) yuksekligini kaplar ve viewport'un
                         USTUNE hizalanir. Bu, az sonucta (orn. 1-2 kart) secili kartin mavi
                         cercevesinin/arka planinin bos alani doldurmak icin asagiya dogru
                         gereksiz uzamasinin KOK NEDENIYDI (UniformGrid, kendisine verilen
                         ARRANGE boyutunu satir sayisina bolerek hucre yuksekligini hesaplar -
                         Stretch ile bu boyut viewport'un tamamiydi). Yatay eksen etkilenmez,
                         5 sutun hala mevcut genisligi paylasir (kapsamli responsive redesign
                         yapilmadi). -->
                    <ItemsControl x:Name="ResultsItemsControl" Margin="4" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Disari tasindi: dosya adi artik Button'un DISINDA, boylece metin
                                     secimi/kopyalama kartin tek-tik secim davranisiyla catismiyor.
                                     Buton yalnizca thumbnail'i sarar - "kartin gorseli" tek tik hedefi. -->
                                <Border Style="{StaticResource ResultCardBorderStyle}" Padding="6" Margin="6">
                                    <StackPanel>
                                        <Button Click="ResultCard_Click" MouseDoubleClick="ResultCard_DoubleClick"
                                                Template="{StaticResource ResultCardButtonTemplate}" Cursor="Hand">
                                            <Border BorderBrush="LightGray" BorderThickness="1" Height="110" Background="White">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                                            </Border>
                                        </Button>
                                        <TextBox Text="{Binding FileName, Mode=OneWay}"
                                                 Style="{StaticResource SelectableFileNameStyle}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding ScoreText}" FontWeight="Bold" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Alt bilgi: artik ayri bir acik panel/blok degil - ana pencere zeminiyle
             birlesir, metin rengi DynamicResource ile temaya gore okunabilir kalir.
             [Surum bilgisi - 2026-09-07] Satir artik 2 sutunlu responsive bir Grid:
             sol tarafta Assembly metadata'dan okunan surum (FooterVersionText -
             Text BURADA SABIT DEGIL, MainWindow constructor'inda AppVersionInfo.
             GetDisplayVersion() ile doldurulur - bkz. o sinif), kalan alanda mevcut
             aciklama metni/tasarimi AYNEN korunur. Sol sutun Auto (dogal genislik,
             asla kirpilmaz), sag sutun kalan TUM genisligi kullanir; TextWrapping=Wrap
             (yeni - savunma amacli) 860 DIP minimum genislikte bile iki metnin ust
             uste binmesini/pencere disina tasmasini engeller. -->
        <Grid Grid.Row="3" x:Name="FooterGrid" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="FooterVersionText" Text="" FontStyle="Italic" VerticalAlignment="Top"
                        Margin="0,0,16,0" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Grid.Column="1" FontStyle="Italic" TextWrapping="Wrap" VerticalAlignment="Top"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="Sistem kesin eşleşme belirtmez; en yakın adaylar listelenir. Son kararı kullanıcı verir." />
        </Grid>
    </Grid>
</Window>
