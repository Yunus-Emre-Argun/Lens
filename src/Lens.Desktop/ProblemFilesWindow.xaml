<Window x:Class="Lens.Desktop.ProblemFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sorunlu / Atlanan Dosyalar" Height="420" Width="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="İndeksleme sırasında işlenemeyen veya desteklenmeyen dosyalar. Teknik ayrıntı için log dosyasına bakınız (%LocalAppData%\Lens\logs\)." />

        <DataGrid Grid.Row="1" x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="2*" />
                <DataGridTextColumn Header="Format" Binding="{Binding Extension}" Width="80" />
                <DataGridTextColumn Header="Sorun" Binding="{Binding KindText}" Width="150" />
                <DataGridTextColumn Header="Sebep" Binding="{Binding Reason}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
