<Project>
  <!--
    [PILOT ClickOnce profili - cok modelli arama - 2026-09-10]

    Mevcut ClickOnce profillerine ve ciktilarina DOKUNULMAZ:
      - Orijinal CLIP   : ClickOnce.pubxml            -> publish\ClickOnce\
      - DINOv2 pilotu   : ClickOnceDinoV2.pubxml      -> publish\ClickOnce-dinov2-base\
      - BU pilot        : ClickOnceMultiModel.pubxml  -> publish\ClickOnce-multi-model\

    BAGIMSIZ KURULUM KIMLIGI: ClickOnce'in kurulum kimligi gorunen addan
    DEGIL, deployment manifestindeki assemblyIdentity adindan turer ve o da
    AssemblyName'e baglidir. Bu yuzden AssemblyName degistirilir:

        Lens.Desktop  ->  Lens.Desktop.MultiModel

    Boylece manifest "Lens.Desktop.MultiModel.application" adini tasir ve
    ClickOnce bunu AYRI BIR UYGULAMA olarak gorur - kullanicinin test ettigi
    DINOv2 pilotunun uzerine KURULMAZ.

    Ayrica Lens.Desktop.csproj'daki LensDataFolder ozelligi veri klasorunu
    %LocalAppData%\Lens.MultiModel\ yapar; pilot, diger kurulumlarin
    ayarlarini/loglarini EZMEZ.

    URETME (dotnet publish ClickOnce manifestini DESTEKLEMEZ - MSB4803):
      "%ProgramFiles%\Microsoft Visual Studio\<surum>\<edition>\MSBuild\Current\Bin\MSBuild.exe" ^
        src\Lens.Desktop\Lens.Desktop.csproj /t:Restore,Publish ^
        /p:PublishProfile=ClickOnceMultiModel /p:Configuration=Release /p:DebugType=none

    Makineye ozel HICBIR mutlak yol burada YOKTUR.
  -->
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- [BAGIMSIZ KIMLIK] Yalnizca bu profille publish yapildiginda gecerli;
         normal derleme "Lens.Desktop" adini kullanmaya devam eder. -->
    <AssemblyName>Lens.Desktop.MultiModel</AssemblyName>

    <PublishDir>..\..\publish\ClickOnce-multi-model\</PublishDir>

    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <BootstrapperEnabled>true</BootstrapperEnabled>

    <!-- Masaustu/Baslat menusu kisayolu diger pilotlardan ayirt edilebilsin. -->
    <ProductName>Lens (Çok Modelli Pilot)</ProductName>

    <!-- Gercek sirket/yayinci adi hala bilinmiyor (Not Yet Decided #9). -->
    <PublisherName>[PLACEHOLDER] Yayıncı Adı Belirlenmedi</PublisherName>

    <!-- Gercek UNC/HTTPS adresi bilinmiyor (Not Yet Decided #10) - bos.
         Bu YEREL/OFFLINE bir deneme paketidir: kurulum calisir, otomatik
         guncelleme adres girilene kadar ISLEVSIZDIR. Tamamlanmis bir uretim
         dagitimi DEGILDIR. -->
    <InstallUrl></InstallUrl>
    <UpdateUrl></UpdateUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <!-- Kimlik zaten bagimsiz oldugu icin surumu yapay olarak yukseltmeye
         GEREK YOKTUR; tek surum kaynagi (FileVersion) korunur. -->
    <ApplicationVersion>$(FileVersion)</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>

    <!-- Gercek kod imzalama sertifikasi yok (Not Yet Decided #11). -->
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>

    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
