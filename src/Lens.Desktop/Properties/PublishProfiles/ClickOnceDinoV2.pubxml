<Project>
  <!--
    [PILOT ClickOnce publish profili - 2026-09-10]

    Bu profil, `feature/dinov2-base-pilot` dalindaki DINOv2-Base surumunun
    KULLANICI TARAFINDAN DENENEBILMESI icin AYRI bir ClickOnce paketi uretir.

    MEVCUT CLIP PROFILINE VE PAKETINE DOKUNULMAZ:
      - Eski profil  : Properties\PublishProfiles\ClickOnce.pubxml  (DEGISMEDI)
      - Eski paket   : publish\ClickOnce\                           (DEGISMEDI)
      - Yeni paket   : publish\ClickOnce-dinov2-base\               (bu profil)
    Iki klasor birbirinden tamamen bagimsizdir; bu profil eski klasore
    hicbir sey yazmaz ve oradan hicbir sey silmez.

    Asagidaki ayarlarin TAMAMI, ClickOnce.pubxml ile BILEREK ayni tutulmustur
    (kullanici bazli kurulum, self-contained, offline, masaustu kisayolu,
    imzasiz, bos InstallUrl/UpdateUrl, placeholder yayinci adi) - yalnizca
    UC sey farklidir ve her biri asagida gerekcelendirilmistir:
      1. PublishDir     (ayri klasor - gorev talimati)
      2. ProductName    (kisayol/Baslat menusu adinda pilot oldugu belli olsun)
      3. ApplicationVersion (mevcut kurulu 1.0.0.0 uzerine kurulabilmesi icin)

    Paketlenen model: models\dinov2-base.onnx (~330 MB). CLIP modeli bu dalda
    Lens.Desktop.csproj tarafindan zaten pakete DAHIL EDILMEZ.

    ONEMLI - "dotnet publish"/"dotnet msbuild" (.NET Core MSBuild) ClickOnce
    manifest ureten gorevi DESTEKLEMEZ (MSB4803) - TAM .NET Framework
    MSBuild'i kullanilmalidir:

      "%ProgramFiles%\Microsoft Visual Studio\<surum>\<edition>\MSBuild\Current\Bin\MSBuild.exe" ^
        src\Lens.Desktop\Lens.Desktop.csproj /t:Restore,Publish ^
        /p:PublishProfile=ClickOnceDinoV2 /p:Configuration=Release /p:DebugType=none

    "/p:DebugType=none" komut satirinda AYRICA verilmelidir: buradaki deger
    yalnizca Lens.Desktop'in KENDI derlemesine uygulanir, proje referansi olan
    Lens.Core AYRI bir MSBuild cagrisiyla derlenir ve .pdb hic sevk edilmese
    bile Lens.Core.dll icinde derleme makinesinin yerel yolunu iceren gomulu
    bir PDB referansi kalir (bkz. ClickOnce.pubxml ayni not, docs/CLICKONCE.md).

    Makineye/gelistiriciye ozel HICBIR mutlak yol burada YOKTUR.
  -->
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- [FARK 1/3] Ayri staging klasoru - eski publish\ClickOnce\ AYNEN
         yerinde kalir. Repo-koku-goreli ve .gitignore'lu ("publish/"). -->
    <PublishDir>..\..\publish\ClickOnce-dinov2-base\</PublishDir>

    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <BootstrapperEnabled>true</BootstrapperEnabled>

    <!-- [FARK 2/3] Kullanici, masaustunde/Baslat menusunde hangi surumu
         actigini karistirmasin diye pilot oldugu ADINDA belirtilir.
         DIKKAT: bu YALNIZCA gorunen addir - ClickOnce'in kurulum KIMLIGI
         deployment manifestinin assemblyIdentity adindan
         ("Lens.Desktop.application") turer ve o ad AssemblyName'e baglidir.
         Yani bu paket, mevcut CLIP paketiyle AYNI uygulama kimligine
         sahiptir ve onun UZERINE kurulur (yan yana iki kurulum OLMAZ).
         Yan yana kurulum icin AssemblyName degistirilmesi gerekirdi - bu,
         pilot kapsami disinda birakildi (bkz. docs/CLICKONCE.md
         "[PILOT] DINOv2 deneme paketi"). Geri donus: eski paketteki
         publish\ClickOnce\setup.exe yeniden calistirilir. -->
    <ProductName>Lens (DINOv2 Pilot)</ProductName>

    <!-- Gercek sirket/yayinci adi hala bilinmiyor - uydurma ad YAZILMADI
         (bkz. docs/DECISIONS.md Not Yet Decided #9). -->
    <PublisherName>[PLACEHOLDER] Yayıncı Adı Belirlenmedi</PublisherName>

    <!-- Gercek UNC/HTTPS adresi hala bilinmiyor (Not Yet Decided #10) -
         bos birakildi: setup.exe ile yerel kurulum calisir, otomatik
         guncelleme kontrolu adres girilene kadar islevsizdir. -->
    <InstallUrl></InstallUrl>
    <UpdateUrl></UpdateUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <!-- [FARK 3/3] Bu deger, ClickOnce.pubxml'deki gibi $(FileVersion)'dan
         TURETILMEDI - bilerek. Gerekce: FileVersion su an 1.0.0.0 ve mevcut
         CLIP ClickOnce paketi de 1.0.0.0 ile uretilmisti; ayni kimlik + ayni
         surumle kurulum denendiginde ClickOnce "zaten kurulu" deyip hicbir
         sey yapmayabilir, yani pilot DENENEMEZ. Pilotun kurulabilmesi icin
         daha yuksek bir surum gerekir.

         1.1.0.0 secildi (1.0.x degil): bu bir urun surum artisi DEGIL, yalnizca
         "pilot deneme paketi" isaretidir ve gercek surum politikasini
         (docs/DEPLOYMENT.md §9 - FileVersion tek kaynak) DEGISTIRMEZ.
         Lens.Desktop.csproj'daki AssemblyVersion/FileVersion/
         InformationalVersion DEGISTIRILMEDI - uygulama icinde gorunen surum
         metni hala "08.09.26 — v1.0"dir (iki farkli surum kavrami icin bkz.
         docs/CLICKONCE.md §4).

         Pilot kabul edilirse bu override KALDIRILMALI ve normal
         $(FileVersion) akisina donulmelidir. -->
    <ApplicationVersion>1.1.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>

    <!-- Gercek kod imzalama sertifikasi yok - sahte/test sertifikasi
         OLUSTURULMADI (CLAUDE.md kural 7, Not Yet Decided #11). Imzasiz
         manifestler Windows'ta "Bilinmeyen yayinci" uyarisi gosterebilir. -->
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>

    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
