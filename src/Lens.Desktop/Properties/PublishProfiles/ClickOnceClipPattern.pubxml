<Project>
  <!--
    [PILOT ClickOnce publish profili - desen odakli CLIP - 2026-09-10]

    Bu profil, `feature/clip-pattern-pilot` dalindaki desen odakli CLIP
    surumunun kullanici tarafindan DENENEBILMESI icin AYRI bir ClickOnce
    paketi uretir.

    MEVCUT PROFILLERE VE PAKETLERE DOKUNULMAZ:
      - CLIP (orijinal) : ClickOnce.pubxml          -> publish\ClickOnce\
      - DINOv2 pilotu   : ClickOnceDinoV2.pubxml    -> publish\ClickOnce-dinov2-base\
      - BU pilot        : ClickOnceClipPattern.pubxml -> publish\ClickOnce-clip-pattern\

    ================= YAN YANA KURULUM (onceki pilottan FARKI) =================

    DINOv2 pilotu, ayri klasor ve ayri gorunen ada sahip olmasina ragmen
    mevcut kurulumun UZERINE kuruluyordu: ClickOnce'in kurulum KIMLIGI
    gorunen addan degil, deployment manifestindeki
    `assemblyIdentity name` degerinden turer ve o da `AssemblyName`'e baglidir.

    Bu profil `AssemblyName`'i DEGISTIRIR:

        Lens.Desktop  ->  Lens.Desktop.ClipPattern

    Boylece uretilen manifest `Lens.Desktop.ClipPattern.application` adini
    tasir ve ClickOnce bunu AYRI BIR UYGULAMA olarak gorur. Kullanici
    su anda test ettigi DINOv2 pilotunu KAYBETMEDEN bu surumu de kurabilir.

    `AssemblyName` degisikliginin guvenli oldugu noktalar:
      - WPF kaynak/pack URI'leri ("/Assets/Lens.ico") calisma zamaninda
        AKTIF assembly'ye gore cozulur, sabit bir ad icermez.
      - AppVersionInfo, calisan assembly'nin metadata'sini okur.
      - Model/appsettings dosyalari ada gore degil, klasore gore bulunur.

    ================= KULLANICI AYARLARININ AYRILMASI ==========================

    Ayrica bu dalda `Lens.Desktop.csproj` icindeki `LensDataFolder` ozelligi
    veri klasorunu `%LocalAppData%\Lens.ClipPattern\` yapar; boylece pilot,
    kullanicinin ASIL kurulumunun temasini/esigini/loglarini EZMEZ.

    ================= INDEKS AYRIMI ============================================

    Desen pilotu index'ini `<UrunDizini>\.lens\indexes\clip-pattern-v1\`
    altinda tutar; eski CLIP (`.lens\index.json`) ve DINOv2
    (`.lens\indexes\dinov2-base-v1\`) dosyalarina DOKUNMAZ.

    ================= URETME ===================================================

    "dotnet publish" ClickOnce manifest gorevini DESTEKLEMEZ (MSB4803) -
    TAM .NET Framework MSBuild'i gerekir:

      "%ProgramFiles%\Microsoft Visual Studio\<surum>\<edition>\MSBuild\Current\Bin\MSBuild.exe" ^
        src\Lens.Desktop\Lens.Desktop.csproj /t:Restore,Publish ^
        /p:PublishProfile=ClickOnceClipPattern /p:Configuration=Release /p:DebugType=none

    "/p:DebugType=none" komut satirinda AYRICA verilmelidir (gerekce icin
    bkz. ClickOnce.pubxml ve docs/CLICKONCE.md).

    Makineye/gelistiriciye ozel HICBIR mutlak yol burada YOKTUR.
  -->
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- [BAGIMSIZ KIMLIK] Kurulum kimliginin kaynagi. Yalnizca bu profille
         publish yapildiginda gecerlidir; normal derleme/publish akisi
         "Lens.Desktop" adini kullanmaya devam eder. -->
    <AssemblyName>Lens.Desktop.ClipPattern</AssemblyName>

    <!-- Ayri staging klasoru - diger iki ClickOnce klasoru AYNEN yerinde kalir. -->
    <PublishDir>..\..\publish\ClickOnce-clip-pattern\</PublishDir>

    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <BootstrapperEnabled>true</BootstrapperEnabled>

    <!-- Kisayol/Baslat menusu adi - kullanici hangi pilotu actigini
         karistirmasin. Kimlik ayrimini bu DEGIL, yukaridaki AssemblyName
         saglar. -->
    <ProductName>Lens (CLIP Desen Pilotu)</ProductName>

    <!-- Gercek sirket/yayinci adi hala bilinmiyor - uydurma ad YAZILMADI
         (bkz. docs/DECISIONS.md Not Yet Decided #9). -->
    <PublisherName>[PLACEHOLDER] Yayıncı Adı Belirlenmedi</PublisherName>

    <!-- Gercek UNC/HTTPS adresi hala bilinmiyor (Not Yet Decided #10) -
         bos birakildi. Bu, YEREL/OFFLINE bir deneme paketidir: setup.exe ile
         kurulum calisir, ancak otomatik guncelleme kontrolu adres girilene
         kadar ISLEVSIZDIR - bu paket tamamlanmis bir uretim dagitimi DEGILDIR. -->
    <InstallUrl></InstallUrl>
    <UpdateUrl></UpdateUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <!-- Kimlik ZATEN bagimsiz oldugu icin surumu yapay olarak yukseltmeye
         GEREK YOKTUR - bu paket hicbir mevcut kurulumun uzerine kurulmaz.
         Bu yuzden mevcut tek surum kaynagi (Lens.Desktop.csproj > FileVersion)
         AYNEN kullanilir; docs/DEPLOYMENT.md §9'daki kural KORUNUR ve
         uygulamada gorunen sürüm metni DEGISMEZ. -->
    <ApplicationVersion>$(FileVersion)</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>

    <!-- Gercek kod imzalama sertifikasi yok - sahte/test sertifikasi
         OLUSTURULMADI (CLAUDE.md kural 7, Not Yet Decided #11). -->
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>

    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
