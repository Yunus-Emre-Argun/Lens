<Project>
  <!--
    [ClickOnce profili - kompakt arama yerlesimi - 2026-09-11]

    Mevcut ClickOnce profillerine ve ciktilarina DOKUNULMAZ:
      - Orijinal CLIP          : ClickOnce.pubxml                      -> publish\ClickOnce\
      - DINOv2 pilotu          : ClickOnceDinoV2.pubxml                -> publish\ClickOnce-dinov2-base\
      - Cok modelli pilot      : ClickOnceMultiModel.pubxml            -> publish\ClickOnce-multi-model\
      - Cok modelli + desen kodu: ClickOnceMultiModelDesenCode.pubxml  -> publish\ClickOnce-multi-model-desen-code\
      - BU paket               : ClickOnceCompactLayout.pubxml         -> publish\ClickOnce-compact-search-layout\

    ── BU PAKET HANGI KURULUMUN GUNCELLEMESIDIR? ────────────────────────────
    AssemblyName BILEREK "Lens.Desktop.MultiModel" olarak BIRAKILDI, yani
    deployment manifest adi yine "Lens.Desktop.MultiModel.application"dir.
    Paket, kurulu

        "Lens (Çok Modelli Pilot)"

    kurulumunun GUNCELLEMESIDIR - onun UZERINE kurulur. Yan yana kurulum
    YOKTUR ve bilerek istenmemistir: bu bir yerlesim duzenlemesidir, ayri bir
    urun degil.

    ── SURUM ────────────────────────────────────────────────────────────────
    Onceki paketler: cok modelli 1.0.0.0, desen kodu entegrasyonu 1.0.0.1.
    Bu paket 1.0.0.2 olmalidir - ayni kimlik + ayni surum ClickOnce
    tarafindan "zaten kurulu" sayilir ve kurulum CALISMAZ.

    DIKKAT (dogrulanarak yasandi): ApplicationRevision YALNIZCA
    ApplicationVersion ".*" ile bittiginde uygulanir. Duz $(FileVersion)
    yazildiginda revizyon SESSIZCE YOK SAYILIR ve paket yine 1.0.0.0 olur.
    Bu yuzden FileVersion'in ilk UC parcasi alinip sonuna ".*" eklenir;
    surum hala TEK kaynaktan (FileVersion) turer, elle yazilmaz.
    Her publish'ten sonra *.application icindeki assemblyIdentity/version
    ELLE KONTROL EDILMELIDIR.

    Bu bir URUN SURUM ARTISI DEGILDIR: Lens.Desktop.csproj'daki
    AssemblyVersion/FileVersion/InformationalVersion DEGISTIRILMEDI ve
    karar #80'in "tek surum kaynagi" kurali korundu.

    ── SERVIS ADRESI ────────────────────────────────────────────────────────
    ClickOnce dagitilan HER dosyanin hash'ini manifeste yazar; paket
    uretildikten SONRA appsettings.json'i elle degistirmek kurulumu BOZAR.
    Gercek uc adresi publish ANINDA appsettings.json icinde olmalidir
    (bkz. docs/DESEN_CODE_SERVICE.md §2.5, §8). Repo'daki ornek dosyada
    Endpoint BOS kalir; adres kaynak koda GOMULMEZ. Kimlik bilgisi
    (VPN kullanici adi/sifre) hicbir dosyaya YAZILMAZ.

    URETME (dotnet publish ClickOnce manifestini DESTEKLEMEZ - MSB4803):
      "%ProgramFiles%\Microsoft Visual Studio\<surum>\<edition>\MSBuild\Current\Bin\MSBuild.exe" ^
        src\Lens.Desktop\Lens.Desktop.csproj /t:Restore,Publish ^
        /p:PublishProfile=ClickOnceCompactLayout /p:Configuration=Release /p:DebugType=none

    Makineye ozel HICBIR mutlak yol burada YOKTUR.
  -->
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- [AYNI KIMLIK] Cok modelli kurulumun GUNCELLEMESI olmasi icin bilerek degistirilmedi. -->
    <AssemblyName>Lens.Desktop.MultiModel</AssemblyName>

    <PublishDir>..\..\publish\ClickOnce-compact-search-layout\</PublishDir>

    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <BootstrapperEnabled>true</BootstrapperEnabled>

    <!-- Guncelleme oldugu icin kisayol adi AYNEN korunur. -->
    <ProductName>Lens (Çok Modelli Pilot)</ProductName>

    <!-- Gercek sirket/yayinci adi hala bilinmiyor (Not Yet Decided #9). -->
    <PublisherName>[PLACEHOLDER] Yayıncı Adı Belirlenmedi</PublisherName>

    <!-- Gercek UNC/HTTPS adresi bilinmiyor (Not Yet Decided #10) - bos. -->
    <InstallUrl></InstallUrl>
    <UpdateUrl></UpdateUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <ApplicationVersion>$(FileVersion.Substring(0, $(FileVersion.LastIndexOf(".")))).*</ApplicationVersion>
    <ApplicationRevision>2</ApplicationRevision>

    <!-- Gercek kod imzalama sertifikasi yok (Not Yet Decided #11). -->
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>

    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
