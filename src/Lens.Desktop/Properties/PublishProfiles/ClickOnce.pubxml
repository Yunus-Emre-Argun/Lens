<Project>
  <!--
    [ClickOnce publish profili - 2026-09-08]
    Bu dosya, Visual Studio'nun ClickOnce Publish sihirbazinin urettigi
    standart .pubxml semasiyla uyumludur ve kaynak kontrolune alinmistir.

    ONEMLI - "dotnet publish"/"dotnet msbuild" (.NET Core MSBuild) ClickOnce
    manifest ureten "UpdateManifest" görevini DESTEKLEMEZ (MSB4803 hatasi
    verir, yerinde denenip dogrulandi) - ClickOnce publish'i Visual Studio'nun
    TAM .NET Framework MSBuild'i ile calistirilmalidir (VS kurulu degilse
    "Build Tools for Visual Studio" ile de mumkundur, ayri kurulum gerekir).

    Kullanim (komut satirindan, VS acmadan):
      "%ProgramFiles%\Microsoft Visual Studio\<surum>\<edition>\MSBuild\Current\Bin\MSBuild.exe" ^
        src\Lens.Desktop\Lens.Desktop.csproj /t:Restore,Publish ^
        /p:PublishProfile=ClickOnce /p:Configuration=Release /p:DebugType=none

    "/p:DebugType=none" NEDEN komut satirinda AYRICA verilir: asagidaki
    PropertyGroup'taki DebugType=none, yalnizca Lens.Desktop projesinin
    KENDI derlemesine uygulanir - proje referansi olan Lens.Core icin AYRI
    bir MSBuild cagrisiyla derlenir ve bu profildeki deger ona otomatik
    tasinmiyor (yerinde test edilerek dogrulandi: DebugType=none olmadan
    Lens.Core.dll icine, hic .pdb sevk edilmese bile, derleme makinesinin
    yerel yolunu iceren gomulu bir PDB referansi kaliyordu). Komut satirinda
    global property olarak verildiginde tum proje grafigine (Lens.Desktop +
    Lens.Core) uygulanir - bkz. docs/CLICKONCE.md "Doğrulama".

    Bu profil, mevcut taşınabilir self-contained publish akisini
    (docs/DEPLOYMENT.md §1, "dotnet publish -r win-x64 (self contained true)")
    ETKILEMEZ - yalnizca acikca "PublishProfile=ClickOnce" verildiginde
    devreye girer.

    Makineye ozel/gelistiriciye ozel HICBIR mutlak yol (ör. "C:\Users\...")
    burada YOKTUR - PublishDir repo-koku-goreli, gitignore'lu bir klasordur.

    Acik/bekleyen kararlar (bkz. docs/CLICKONCE.md "Açık Kararlar"):
      - PublisherName: gercek sirket adi bilinmiyor, asagida acik placeholder var.
      - InstallUrl/UpdateUrl: gercek UNC/HTTPS adresi bilinmiyor, bos birakildi.
      - SignManifests: gercek kod imzalama sertifikasi yok, false birakildi.
  -->
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Repo-koku-goreli, .gitignore ile hariç tutulan staging klasoru
         (bkz. .gitignore "publish/"). Gerektiginde
         "-p:PublishDir=<baska-yol>" ile komut satirindan ezilebilir -
         gelistirici makinesine ozel bir yol buraya KALICI yazilmaz. -->
    <PublishDir>..\..\publish\ClickOnce\</PublishDir>

    <!-- Kullanici bazli kurulum, disk/USB/paylasilan-klasor uzerinden
         (offline calisir - web bootstrapper degil). -->
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>

    <!-- Self-contained oldugu icin hedef makinede .NET Desktop Runtime
         onkosulu (prerequisite) gerekmez, ancak "setup.exe" bootstrapper
         cikti dosyasini uretmek icin bu bayrak true kalmalidir (false
         yapildiginda sadece Launcher.exe uretiliyor, setup.exe uretilmiyor -
         yerinde test edilerek dogrulandi). -->
    <BootstrapperEnabled>true</BootstrapperEnabled>

    <!-- Uygulama adi (gorev talimati: "Lens"). -->
    <ProductName>Lens</ProductName>

    <!-- [PLACEHOLDER] Gercek sirket/yayinci adi henuz bilinmiyor - uydurma
         kisisel/sirket adi YAZILMADI. Yayinlamadan once gercek adla
         degistirilmelidir. -->
    <PublisherName>[PLACEHOLDER] Yayıncı Adı Belirlenmedi</PublisherName>

    <!-- [PLACEHOLDER] Gercek UNC (\\sunucu\LensDeploy\) veya HTTPS
         guncelleme adresi henuz bilinmiyor - Google Drive baglantisi veya
         uydurma bir adres YAZILMADI. Bos oldugunda publish yerel/offline
         bir staging klasorune uretilir: setup.exe ile kurulum calisir,
         ancak otomatik guncelleme kontrolu adres girilene kadar islevsizdir.
         Adres netlesince HEM InstallUrl HEM UpdateUrl doldurulmalidir -
         bkz. docs/CLICKONCE.md "Gerçek Yayın/Güncelleme Adresini Tanımlama". -->
    <InstallUrl></InstallUrl>
    <UpdateUrl></UpdateUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <!-- ClickOnce'in 4 parcali surekli-artan surumu. Ayri, elle tutulan bir
         sayi DEGIL - mevcut sayisal surum kaynagi
         (Lens.Desktop.csproj > FileVersion, zaten "major.minor.build.revision"
         formatinda) burada MSBuild property referansiyla yeniden kullanilir.
         Yeni bir ClickOnce surumu yayimlamak icin FileVersion'i (bkz.
         docs/DEPLOYMENT.md §9) artirip yeniden publish almak yeterlidir -
         ayrintili adimlar: docs/CLICKONCE.md "Sürüm Artırma".
         ONEMLI (yerinde test edilerek dogrulandi): Bu komut satiri MSBuild
         akisi, ayni/dusuk bir surumle ayni PublishDir'e tekrar publish
         yapildiginda HATA VERMEZ/REDDETMEZ - sessizce ustune yazar (Visual
         Studio Publish sihirbazinin IDE ici uyarisi burada YOKTUR). Surum
         geriye dusmesine karsi tek koruma, publish oncesi FileVersion'in
         MUTLAKA artirilmasidir (elle disiplin, otomatik guvenlik agi YOK) -
         bkz. docs/CLICKONCE.md "Sürüm Artırma" ve "Açık Kararlar". Zaten
         guncellenmis istemciler (kurulu surumleri manifestteki surumden
         yuksekse) ClickOnce istemci tarafi kontrolu geregi yine de geriye
         dogru "guncelleme" almaz - risk asıl YENİ kurulumlar icindir. -->
    <ApplicationVersion>$(FileVersion)</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>

    <!-- Gercek sirket kod imzalama sertifikasi yok - sahte/test sertifikasi
         OLUSTURULMADI ve Windows sertifika deposuna YUKLENMEDI (bkz.
         CLAUDE.md kural 7, docs/CLICKONCE.md "İmzalama"). Imzasiz
         deployment/application manifestleri Windows'ta "Bilinmeyen
         yayinci" uyarisi gosterebilir. -->
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>

    <!-- Publish ciktisindaki .pdb dosyalari yerel gelistirici makine yolunu
         icerebilir (bkz. docs/PRODUCTION_CHECKLIST.md, Codex bulgusu) -
         ClickOnce paketine hic PDB dahil edilmez. Mevcut Release publish'in
         (docs/DEPLOYMENT.md §1) PDB davranisi bu profilden ETKILENMEZ.
         ONEMLI: bu deger yalnizca Lens.Desktop'in KENDI derlemesine
         uygulanir - Lens.Core proje referansi icin de ayni korumayi almak
         icin publish komutuna AYRICA "/p:DebugType=none" verilmelidir
         (yukaridaki dosya basi yorumuna bkz.), aksi halde Lens.Core.dll
         icine (PDB dosyasi hic sevk edilmese dahi) derleme makinesinin
         yerel dosya yolunu iceren gomulu bir PDB referansi kalir - yerinde
         test edilerek dogrulandi. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
