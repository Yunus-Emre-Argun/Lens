<Project>
  <!--
    [ClickOnce profili - cok modelli arama + desen kodu servisi - 2026-09-11]

    Mevcut ClickOnce profillerine ve ciktilarina DOKUNULMAZ:
      - Orijinal CLIP      : ClickOnce.pubxml                      -> publish\ClickOnce\
      - DINOv2 pilotu      : ClickOnceDinoV2.pubxml                -> publish\ClickOnce-dinov2-base\
      - Cok modelli pilot  : ClickOnceMultiModel.pubxml            -> publish\ClickOnce-multi-model\
      - BU paket           : ClickOnceMultiModelDesenCode.pubxml   -> publish\ClickOnce-multi-model-desen-code\

    ── BU PAKET HANGI KURULUMUN GUNCELLEMESIDIR? ────────────────────────────
    AssemblyName BILEREK "Lens.Desktop.MultiModel" olarak BIRAKILDI, yani
    deployment manifest adi yine "Lens.Desktop.MultiModel.application"dir.
    Bu nedenle paket YENI bir uygulama degil, kurulu

        "Lens (Çok Modelli Pilot)"

    kurulumunun GUNCELLEMESIDIR - o kurulumun UZERINE kurulur. Yan yana
    kurulum YOKTUR ve bilerek istenmemistir: ayni ozellik setinin ikinci bir
    kopyasi, ayni katalogda ikinci bir ayar/log klasoru ve kullanicida
    "hangisi guncel?" belirsizligi yaratirdi.

    ── SURUM: NEDEN ApplicationRevision ARTIRILDI? ──────────────────────────
    Mevcut publish\ClickOnce-multi-model\ paketi 1.0.0.0 ile uretildi. AYNI
    kimlik + AYNI surum ile ikinci bir paket ClickOnce tarafindan "zaten
    kurulu" sayilir ve kurulum/guncelleme CALISMAZ (bkz. docs/DECISIONS.md
    #97, DINOv2 pilotunda yasanan durum). Bu yuzden YALNIZCA ClickOnce'a ozel
    ApplicationRevision 0 -> 1 yapildi; paket surumu 1.0.0.1 olur.

    Bu bir URUN SURUM ARTISI DEGILDIR: Lens.Desktop.csproj'daki
    AssemblyVersion/FileVersion/InformationalVersion DEGISTIRILMEDI
    (uygulamada gorunen surum hala "08.09.26 - v1.0") ve karar #80'in
    "tek surum kaynagi" kurali KALDIRILMADI - ApplicationVersion yine
    $(FileVersion)'dan turer, yalnizca revizyon numarasi artar.

    ── SERVIS ADRESI ────────────────────────────────────────────────────────
    ClickOnce, dagitilan HER dosyanin hash'ini manifeste yazar; paket
    uretildikten SONRA appsettings.json'i elle degistirmek kurulumu BOZAR.
    Bu yuzden gercek uc adresi publish ANINDA appsettings.json icinde
    olmalidir (bkz. docs/DESEN_CODE_SERVICE.md "Yapilandirma"). Repo'daki
    ornek dosyada Endpoint BOS kalir; adres kaynak koda GOMULMEZ.
    Kimlik bilgisi (VPN kullanici adi/sifre) hicbir dosyaya YAZILMAZ.

    URETME (dotnet publish ClickOnce manifestini DESTEKLEMEZ - MSB4803):
      "%ProgramFiles%\Microsoft Visual Studio\<surum>\<edition>\MSBuild\Current\Bin\MSBuild.exe" ^
        src\Lens.Desktop\Lens.Desktop.csproj /t:Restore,Publish ^
        /p:PublishProfile=ClickOnceMultiModelDesenCode /p:Configuration=Release /p:DebugType=none

    Makineye ozel HICBIR mutlak yol burada YOKTUR.
  -->
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platform>x64</Platform>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- [AYNI KIMLIK] Cok modelli kurulumun GUNCELLEMESI olmasi icin
         BILEREK degistirilmedi - bkz. yukaridaki aciklama. -->
    <AssemblyName>Lens.Desktop.MultiModel</AssemblyName>

    <PublishDir>..\..\publish\ClickOnce-multi-model-desen-code\</PublishDir>

    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <BootstrapperEnabled>true</BootstrapperEnabled>

    <!-- Guncelleme oldugu icin kisayol adi AYNEN korunur - degistirilseydi
         kullanicinin mevcut kisayolu yeniden adlandirilir, "yeni bir uygulama
         mi kuruldu?" karisikligi olusurdu. -->
    <ProductName>Lens (Çok Modelli Pilot)</ProductName>

    <!-- Gercek sirket/yayinci adi hala bilinmiyor (Not Yet Decided #9). -->
    <PublisherName>[PLACEHOLDER] Yayıncı Adı Belirlenmedi</PublisherName>

    <!-- Gercek UNC/HTTPS adresi bilinmiyor (Not Yet Decided #10) - bos.
         Bu YEREL/OFFLINE bir pakettir: kurulum calisir, otomatik guncelleme
         adres girilene kadar ISLEVSIZDIR. -->
    <InstallUrl></InstallUrl>
    <UpdateUrl></UpdateUrl>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateRequired>false</UpdateRequired>

    <!-- Tek surum kaynagi (FileVersion) korunur; YALNIZCA ClickOnce revizyonu
         artar ki ayni kimlikli onceki 1.0.0.0 paketi "zaten kurulu" sayilmasin. -->
    <ApplicationVersion>$(FileVersion)</ApplicationVersion>
    <ApplicationRevision>1</ApplicationRevision>

    <!-- Gercek kod imzalama sertifikasi yok (Not Yet Decided #11). -->
    <SignManifests>false</SignManifests>
    <GenerateManifests>true</GenerateManifests>

    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
